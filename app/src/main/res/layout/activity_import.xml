<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="上传课表图片，自动识别生成课表"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="支持识别分专业课表（如软件开发 / 大数据技术），识别后可手动校正"
        android:textColor="@color/ink2"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/imgPreview"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="10dp"
        android:scaleType="fitCenter"
        android:background="@color/card"
        android:contentDescription="课表图片预览" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="选择图片" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRecognize"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:text="开始识别"
            android:enabled="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnExpandSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="▲ 展开识别设置（引擎 / 专业 / 粘贴导入）"
        android:textColor="@color/primary_dark"
        android:textSize="12sp"
        android:textStyle="bold"
        android:padding="6dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/llHideZone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="识别引擎"
            android:textColor="@color/ink2"
            android:textSize="12sp" />

        <RadioGroup
            android:id="@+id/rgEngine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbOffline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="离线识别（推荐，无需联网）"
                android:textColor="@color/ink"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbCloud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="百度云端（需在设置填 Key）"
                android:textColor="@color/ink" />

            <RadioButton
                android:id="@+id/rbCustom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="大模型识别（GPT-4o/Qwen-VL/GLM-4V 等，在设置配置）"
                android:textColor="@color/ink" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvMajor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <RadioGroup
            android:id="@+id/rgMajor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCopyPrompt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="10dp"
                android:text="复制识别提示词"
                android:textColor="@color/primary_dark"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip" />

            <TextView
                android:id="@+id/btnPasteJson"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"
                android:gravity="center"
                android:padding="10dp"
                android:text="粘贴大模型结果导入"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_primary" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="方式：复制提示词 → 发给任意大模型（附上课表图片）→ 把返回的 JSON 粘贴回来 → 自动生成课表"
            android:textColor="@color/ink2"
            android:textSize="11sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGenerate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="生成课表"
        android:enabled="false" />
</LinearLayout>
