<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="学期设置"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="第 1 周周一日期（用于自动计算当前周）"
            android:textColor="@color/ink2"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etYear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:background="@drawable/bg_input"
                android:padding="10dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink2"
                android:hint="年，如 2026" />

            <EditText
                android:id="@+id/etMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:inputType="number"
                android:background="@drawable/bg_input"
                android:padding="10dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink2"
                android:hint="月，如 9" />

            <EditText
                android:id="@+id/etDay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:inputType="number"
                android:background="@drawable/bg_input"
                android:padding="10dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink2"
                android:hint="日，如 7" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="百度云端 OCR（可选）"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="在百度智能云开通「通用文字识别」后，填入 API Key 与 Secret Key，即可在导入时选择云端识别（识别准确率更高，需要联网）"
            android:textColor="@color/ink2"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etAk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:padding="10dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink2"
            android:hint="API Key（AK）"
            android:inputType="text" />

        <EditText
            android:id="@+id/etSk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:padding="10dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink2"
            android:hint="Secret Key（SK）"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="大模型识别（可选）"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="可接入任意主流识图大模型（GPT-4o、通义千问 Qwen-VL、智谱 GLM-4V、Kimi、豆包等）。App 内置课表识别调教提示词，模型直接输出结构化课表。导入时选择「大模型识别」即可使用，识别结果自动调教为课表格式。"
            android:textColor="@color/ink2"
            android:textSize="12sp" />

        <RadioGroup
            android:id="@+id/rgLlmPlatform"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbLlmOpenai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OpenAI 兼容（推荐）"
                android:textColor="@color/ink"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbLlmGemini"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:text="Gemini"
                android:textColor="@color/ink" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="OpenAI 兼容平台 Base URL 示例：OpenAI https://api.openai.com/v1；通义千问 https://dashscope.aliyuncs.com/compatible-mode/v1；智谱 https://open.bigmodel.cn/api/paas/v4；Kimi https://api.moonshot.cn/v1"
            android:textColor="@color/ink2"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/etLlmBaseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:padding="10dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink2"
            android:hint="Base URL（填到 /v1 或 /v4 这层，如 https://api.openai.com/v1）"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/etLlmApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:padding="10dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink2"
            android:hint="API Key"
            android:inputType="text" />

        <EditText
            android:id="@+id/etLlmModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:padding="10dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink2"
            android:hint="模型名，如 gpt-4o-mini / qwen-vl-plus / glm-4v-flash / gemini-2.0-flash"
            android:inputType="text" />

        <EditText
            android:id="@+id/etLlmPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:padding="10dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink2"
            android:hint="课表调教提示词（留空使用内置模板，可自定义）"
            android:inputType="textMultiLine"
            android:singleLine="false"
            android:minLines="4" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="保存设置" />
    </LinearLayout>
</ScrollView>
